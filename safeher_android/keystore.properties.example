# Copy to keystore.properties at project root (never commit keystore.properties)
#
# Generate a release keystore (one-time):
#   keytool -genkey -v -keystore release/safeher-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias safeher
#
# Then fill in the values below. Release builds sign automatically when this file exists.

storeFile=release/safeher-release.jks
storePassword=your_store_password
keyAlias=safeher
keyPassword=your_key_password
