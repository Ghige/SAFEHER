# SafeHer Backend — copy to .env and fill in real values (never commit .env)

DATABASE_URL=postgresql://postgres:password@localhost:5432/safeher_db
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
# Dev may use 1440; production should use ≤120
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Meta WhatsApp Cloud API (required for emergency contact messages)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Dev: omit to use Meta sample template hello_world (en_US)
# Production alert template: {{1}} name, {{2}} trigger, {{3}} maps URL, {{4}} track URL
# Production cancel template: {{1}} name
META_WHATSAPP_TEMPLATE_ALERT=
META_WHATSAPP_TEMPLATE_CANCEL=
META_WHATSAPP_TEMPLATE_LANGUAGE=

# Firebase (RTDB optional; required for FCM push from backend)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379
REQUIRE_REDIS_IN_PRODUCTION=true

ENVIRONMENT=development
DEBUG=true
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=safeher.app,api.safeher.app,localhost,127.0.0.1

# Only "mock" (dev) and "twilio" (Twilio Verify) are implemented.
# production/staging boot will REFUSE OTP_PROVIDER=mock and require Twilio creds when twilio.
OTP_PROVIDER=mock
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_ALLOW_DEV_SHORTCUT=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DRIVE_TOKEN_ENCRYPTION_KEY=

# Stage 0/9 — MUST stay false until AI models pass production gates + confirm-first sign-off.
# Manual SOS (/api/v1/alerts/trigger) is NOT gated by this flag.
AI_AUTO_SOS_ENABLED=false

# Dataset upload privacy (Stage 9)
AI_DATASET_MAX_UPLOAD_BYTES=2000000
AI_DATASET_RETENTION_DAYS=30
AUDIT_LOG_DIR=
AUDIT_RETENTION_DAYS=30
LOG_JSON=false
METRICS_ENABLED=true

# Optional staging recipient for intentional Meta hello_world probe (E.164 digits, no +).
# Leave unset to refuse live message probes. Never use for real emergencies.
# STAGING_WHATSAPP_RECIPIENT=

# Public URLs (no trailing slash)
TRACK_BASE_URL=https://safeher.app/track
API_BASE_URL=https://api.safeher.app
PHONE_COUNTRY_CODE=91

# --- Production checklist (set these before deploy) ---
# See also: .env.production.example and docs in safeher_ai/data/training_logs/P0_PRODUCTION_DEPLOY_CHECKLIST.md
# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=<openssl rand -hex 32>
# OTP_PROVIDER=twilio
# OTP_ALLOW_DEV_SHORTCUT=false
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=...
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# AI_AUTO_SOS_ENABLED=false
# REQUIRE_REDIS_IN_PRODUCTION=true
# DATABASE_URL=<non-default credentials>
