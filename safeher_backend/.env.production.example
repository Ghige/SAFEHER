# SafeHer Backend — PRODUCTION / STAGING template
# Copy to a secret store or a gitignored .env on the server. Never commit filled values.
#
# AI_AUTO_SOS_ENABLED must remain false. DEMO_MODE stays true in DecisionContract assets.

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
DATABASE_URL=postgresql://safeher_app:REPLACE_STRONG_PASSWORD@db-host:5432/safeher_db

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

REDIS_URL=redis://redis-host:6379/0
REQUIRE_REDIS_IN_PRODUCTION=true

# Real OTP — Twilio Verify only (mock forbidden)
OTP_PROVIDER=twilio
OTP_ALLOW_DEV_SHORTCUT=false
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WHATSAPP_TEMPLATE_ALERT=
META_WHATSAPP_TEMPLATE_CANCEL=
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional: controlled number for hello_world staging probe (E.164 digits, no +)
# STAGING_WHATSAPP_RECIPIENT=

FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_DATABASE_URL=

TRUSTED_HOSTS=safeher.app,api.safeher.app
CORS_ALLOWED_ORIGINS=https://safeher.app,https://www.safeher.app
TRACK_BASE_URL=https://safeher.app/track
API_BASE_URL=https://api.safeher.app
PHONE_COUNTRY_CODE=91

AI_AUTO_SOS_ENABLED=false

# Metadata-only AI feedback (WAV uploads are retired)
AI_DATASET_MAX_UPLOAD_BYTES=2000000
AI_DATASET_RETENTION_DAYS=30
AI_FEEDBACK_UNREVIEWED_RETENTION_DAYS=365
AI_FEEDBACK_CONSENT_VERSION=privacy-v2-metadata-only
AUDIT_LOG_DIR=/var/log/safeher/audit
